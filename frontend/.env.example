# Leave empty in local dev to use Vite /api proxy (see frontend/vite.config.ts).
# Set explicitly for production builds or direct API access without proxy.
VITE_API_BASE_URL=

# Internal diagnostics view. Dev builds show it by default via import.meta.env.DEV.
# Set true in production only when exposing /app/runs/:runId/audit is intentional.
VITE_SHOW_DEBUG_PANELS=

# LangSmith 外部控制台入口。可替换为团队项目的直接 URL。
VITE_LANGSMITH_CONSOLE_URL=https://smith.langchain.com/
