# VCS / editor meta
.git
.gitignore
.vscode
.idea
*.iml
.codegraph
*.tsbuildinfo

# Secrets — never send local credentials into build context
# (platform/commerce Dockerfiles do COPY . .)
.env
.env.*
!.env.example
!**/.env.example

# Java / Node / Python build output (rebuilt inside the image)
**/target
**/build
**/dist
**/node_modules
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/__pycache__
**/.venv
*.py[cod]

# Test / coverage artifacts
.coverage
.coverage.*
htmlcov
**/coverage
*.cover
.nyc_output

# Local runtime data and logs
*.log
**/logs
/data
agent-service/data
agent-service/demo_fixtures/generated
*.db

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
