<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aigroup.groupbuy.infrastructure.dao.IGroupBuyActivityTierDao">

    <resultMap id="dataMap" type="com.aigroup.groupbuy.infrastructure.dao.po.GroupBuyActivityTier">
        <id column="id" property="id"/>
        <result column="activity_id" property="activityId"/>
        <result column="tier_no" property="tierNo"/>
        <result column="tier_name" property="tierName"/>
        <result column="target_count" property="targetCount"/>
        <result column="bonus_quota" property="bonusQuota"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="queryTiersByActivityId" parameterType="java.lang.Long" resultMap="dataMap">
        select id, activity_id, tier_no, tier_name, target_count, bonus_quota, status, create_time, update_time
        from group_buy_activity_tier
        where activity_id = #{activityId} and status = 1
        order by tier_no asc
    </select>

</mapper>
