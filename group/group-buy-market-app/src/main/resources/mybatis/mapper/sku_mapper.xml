<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aigroup.groupbuy.infrastructure.dao.ISkuDao">

    <resultMap id="dataMap" type="com.aigroup.groupbuy.infrastructure.dao.po.Sku">
        <id column="id" property="id"/>
        <result column="source" property="source"/>
        <result column="channel" property="channel"/>
        <result column="goods_id" property="goodsId"/>
        <result column="goods_name" property="goodsName"/>
        <result column="original_price" property="originalPrice"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="querySkuByGoodsId" parameterType="java.lang.String" resultMap="dataMap">
        select source, channel, goods_id, goods_name, original_price
        from sku
        where goods_id = #{goodsId}
    </select>

    <!-- 运营端：商品列表 -->
    <select id="querySkuList" resultMap="dataMap">
        select source, channel, goods_id, goods_name, original_price
        from sku
    </select>

    <!-- 运营端：更新商品名称/原价（非空才更新） -->
    <update id="updateSkuGoods" parameterType="com.aigroup.groupbuy.infrastructure.dao.po.Sku">
        update sku
        <set>
            <if test="goodsName != null and goodsName != ''">goods_name = #{goodsName},</if>
            <if test="originalPrice != null">original_price = #{originalPrice},</if>
            update_time = now()
        </set>
        where goods_id = #{goodsId}
    </update>

</mapper>
