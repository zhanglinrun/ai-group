{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiongdoctor.local/contracts/quota-events.schema.json",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "aggregateId", "traceId", "occurredAt", "payload"],
  "properties": {
    "eventId": {"type": "string"},
    "eventType": {"enum": ["QuotaGranted", "QuotaUsageSettled"]},
    "schemaVersion": {"type": "integer", "minimum": 1},
    "aggregateId": {"type": "string"},
    "traceId": {"type": "string"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
