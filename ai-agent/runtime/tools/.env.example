# Synced from repo root .env for local runtime/tools development.
# Copy to .env and fill secrets; do not commit real keys.

# ========== Service boundary ==========
REACTOR_TOOL_ENV=local
REACTOR_TOOL_HOST=127.0.0.1
AI_GROUP_INTERNAL_TOKEN=change-me-to-a-long-random-internal-token
REACTOR_TOOL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ========== Script execution policy ==========
SKILL_ALLOWED_RUNTIMES=python
SKILL_MAX_TIMEOUT_SECONDS=120
SKILL_MAX_CONCURRENT_PROCESSES=2
SKILL_MAX_OUTPUT_BYTES=1048576
SKILL_MAX_MEMORY_MB=2048
SKILL_MAX_FILE_SIZE_MB=100

# ========== LLM ==========
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_MODEL=qwen-plus
REPORT_MODEL=qwen-plus

DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ========== Search / parsing ==========
TAVILY_API_KEY=
MINERU_API_KEY=

SENSITIVE_WORD_REPLACE=true
FILE_SAVE_PATH=file_db_dir
SQLITE_DB_PATH=autobots.db
FILE_SERVER_URL=http://127.0.0.1:1601/v1/file_tool
FILE_MAX_SIZE_MB=100

# ========== Private MinIO object storage ==========
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=agent
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=ai-group-files
