server:
  port: 8090
  forward-headers-strategy: framework

management:
  health:
    elasticsearch:
      enabled: false

spring:
  autoconfigure:
    exclude:
      - org.springframework.ai.mcp.client.httpclient.autoconfigure.SseHttpClientTransportAutoConfiguration
      - org.springframework.ai.mcp.client.httpclient.autoconfigure.StreamableHttpHttpClientTransportAutoConfiguration
      - org.springframework.ai.mcp.client.webflux.autoconfigure.SseWebFluxTransportAutoConfiguration
      - org.springframework.ai.mcp.client.webflux.autoconfigure.StreamableHttpWebFluxTransportAutoConfiguration
  ai:
    agent:
      auto-config:
        enabled: ${AI_AGENT_AUTO_CONFIG_ENABLED:false}
    openai:
      base-url: ${AGENT_GROUP_LLM_BASE_URL:https://dashscope.aliyuncs.com/compatible-mode/v1}
      api-key: ${AGENT_GROUP_LLM_API_KEY:${DASHSCOPE_API_KEY:${AI_BAILIAN_API_KEY:not-configured}}}
      chat:
        completions-path: /chat/completions
        options:
          model: ${AGENT_GROUP_LLM_CHAT_MODEL:qwen-plus}
          temperature: 0.2
          stream-usage: true
      embedding:
        embeddings-path: /embeddings
        metadata-mode: EMBED
        options:
          model: ${AGENT_GROUP_LLM_EMBEDDING_MODEL:text-embedding-v3}
          dimensions: ${AGENT_GROUP_VECTOR_DIMENSION:1024}
          encoding-format: float
  datasource:
    mysql:
      driver-class-name: com.mysql.cj.jdbc.Driver
      url: jdbc:mysql://${MYSQL_HOST:127.0.0.1}:${MYSQL_PORT:13306}/agent_db?useUnicode=true&characterEncoding=utf8&autoReconnect=true&zeroDateTimeBehavior=convertToNull&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
      username: ${MYSQL_USER:root}
      password: ${MYSQL_ROOT_PASSWORD:123456}
      hikari:
        maximum-pool-size: 20
        minimum-idle: 5
  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:16379}
  rabbitmq:
    host: ${RABBITMQ_HOST:127.0.0.1}
    port: ${RABBITMQ_PORT:5672}
    username: ${RABBITMQ_USER:admin}
    password: ${RABBITMQ_PASSWORD:admin}

# member-service 内部配额 API（freeze / confirm / release）
ai-group:
  # platform_context 只读工具使用；身份来自 AgentContext，内部令牌沿用 AI_GROUP_INTERNAL_TOKEN。
  bff-service:
    base-url: ${AI_GROUP_BFF_URL:http://127.0.0.1:8083}
  member-service:
    base-url: ${MEMBER_SERVICE_BASE_URL:http://127.0.0.1:18082}

llm:
  default:
    model: ${AGENT_GROUP_LLM_CHAT_MODEL:qwen-plus}
    max_tokens: ${AGENT_GROUP_LLM_MAX_TOKENS:16384}
    temperature: ${AGENT_GROUP_LLM_TEMPERATURE:0.2}
    base_url: ${AGENT_GROUP_LLM_BASE_URL:https://dashscope.aliyuncs.com/compatible-mode/v1}
    interface_url: /chat/completions
    function_call_type: function_call
    apikey: ${AGENT_GROUP_LLM_API_KEY:${DASHSCOPE_API_KEY:${AI_BAILIAN_API_KEY:not-configured}}}
    max_input_tokens: ${AGENT_GROUP_LLM_MAX_INPUT_TOKENS:100000}

autobots:
  execution:
    heartbeat:
      interval-millis: 10000
    run-recovery:
      enabled: ${AGENT_RUN_RECOVERY_ENABLED:true}
      scan-interval-millis: ${AGENT_RUN_RECOVERY_SCAN_INTERVAL_MILLIS:60000}
      deadline-grace-millis: ${AGENT_RUN_RECOVERY_DEADLINE_GRACE_MILLIS:300000}
      heartbeat-timeout-millis: ${AGENT_RUN_RECOVERY_HEARTBEAT_TIMEOUT_MILLIS:60000}
      batch-limit: ${AGENT_RUN_RECOVERY_BATCH_LIMIT:200}
    cors:
      allowed-origins:
        - http://localhost:5173
        - http://127.0.0.1:5173
  autoagent:
    agent-loop:
      model-name: ${AGENT_GROUP_LLM_CHAT_MODEL:qwen-plus}
      max-turns: ${AGENT_LOOP_MAX_TURNS:40}
      max-tool-calls: ${AGENT_LOOP_MAX_TOOL_CALLS:64}
      max-completion-attempts: ${AGENT_LOOP_MAX_COMPLETION_ATTEMPTS:3}
      max-duration-seconds: ${AGENT_LOOP_MAX_DURATION_SECONDS:900}
      max-total-tokens: ${AGENT_LOOP_MAX_TOTAL_TOKENS:200000}
      max-microcredits: ${AGENT_LOOP_MAX_MICROCREDITS:10000000}
    max-concurrent-dialogues-per-user: ${AGENT_MAX_CONCURRENT_DIALOGUES_PER_USER:3}
    tool:
      max_attempts: ${AGENT_TOOL_MAX_ATTEMPTS:2}
    # 三层对话记忆：短期(单run上下文) / 中期(会话滚动摘要压缩) / 长期(跨会话向量召回)
    memory:
      enabled: ${AGENT_MEMORY_ENABLED:true}
      recent-run-window: ${AGENT_MEMORY_RECENT_RUN_WINDOW:3}
      max-tokens: ${AGENT_MEMORY_MAX_TOKENS:12000}
      compress:
        enabled: ${AGENT_MEMORY_COMPRESS_ENABLED:true}
      longterm:
        # 长期记忆使用下方 Qdrant 连接，但与 DataAgent/问数的 enable 开关相互独立
        enabled: ${AGENT_MEMORY_LONGTERM_ENABLED:false}
        collection: ${AGENT_MEMORY_LONGTERM_COLLECTION:agent_conversation_memory}
        top-k: ${AGENT_MEMORY_LONGTERM_TOP_K:5}
        score-threshold: ${AGENT_MEMORY_LONGTERM_SCORE_THRESHOLD:0.6}
        decay-half-life-days: ${AGENT_MEMORY_LONGTERM_DECAY_HALF_LIFE_DAYS:30}
    skill:
      enabled: ${AGENT_SKILLS_ENABLED:true}
      directories:
        - ${AGENT_SKILLS_DIRECTORY:runtime/skills}
      agent-loop-enabled: ${AGENT_SKILLS_AGENT_LOOP_ENABLED:true}
      max-read-chars: ${AGENT_SKILLS_MAX_READ_CHARS:12000}
      max-list-entries: ${AGENT_SKILLS_MAX_LIST_ENTRIES:200}
      max-glob-results: ${AGENT_SKILLS_MAX_GLOB_RESULTS:100}
      max-grep-matches: ${AGENT_SKILLS_MAX_GREP_MATCHES:100}
      default-script-timeout-seconds: ${AGENT_SKILLS_SCRIPT_TIMEOUT_SECONDS:120}
    code_interpreter_url: ${AGENT_GROUP_REACTOR_TOOL_BASE_URL:http://127.0.0.1:1601}
    reactor_tool_token: ${AGENT_GROUP_REACTOR_TOOL_TOKEN:${AI_GROUP_INTERNAL_TOKEN:${ai-group.internal.token:}}}
    deep_search_url: ${AGENT_GROUP_REACTOR_TOOL_BASE_URL:http://127.0.0.1:1601}
    web_fetch_url: ${AGENT_GROUP_REACTOR_TOOL_BASE_URL:http://127.0.0.1:1601}
    image_generation_url: ${AGENT_GROUP_REACTOR_TOOL_BASE_URL:http://127.0.0.1:1601}
    data_analysis_url: ${AGENT_GROUP_REACTOR_TOOL_BASE_URL:http://127.0.0.1:1601}
  data-agent:
    agent-url: ${AGENT_GROUP_REACTOR_TOOL_BASE_URL:http://127.0.0.1:1601}
    qdrant-config:
      enable: ${AGENT_GROUP_QDRANT_ENABLED:false}
      url: ${QDRANT_URL:http://127.0.0.1:6333}
      port: ${QDRANT_PORT:6334}
      api-key: ${QDRANT_API_KEY:}
      embedding-url: ${AGENT_GROUP_EMBEDDING_URL:}
      prefer-grpc: ${QDRANT_PREFER_GRPC:false}

agent:
  group:
    rabbit:
      enabled: ${AGENT_GROUP_RABBIT_ENABLED:false}
    reactor-tool:
      enabled: ${AGENT_GROUP_REACTOR_TOOL_ENABLED:true}
      base-url: ${AGENT_GROUP_REACTOR_TOOL_BASE_URL:http://127.0.0.1:1601}

# 搜索 / 文档解析（Java 侧工具调用）
tavily:
  api-key: ${TAVILY_API_KEY:}

mineru:
  api-key: ${MINERU_API_KEY:}

grsai:
  nanobanana:
    api-key: ${GRSAI_NANOBANANA_API_KEY:}

skills:
  directory: runtime/skills
  output-directory: outputs

mybatis-plus:
  mapper-locations: classpath*:/mybatis/mapper/*.xml
  config-location: classpath:/mybatis/config/mybatis-config.xml
