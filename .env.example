# AI Group 本地开发环境变量示例
# 用法：复制为 .env 并填入真实值。.env 已在 .gitignore 中，切勿提交真实密钥。
# 注意：docker-compose-platform.yml 目前将基础设施凭据硬编码（root/123456、admin/admin 等），
#       下列变量主要供各 Java 微服务、前端与 start-full-stack.ps1 读取。

# ============ 安全（必填，生产务必替换为强随机值）============
# JWT 签名密钥（所有服务共享，必须一致）
JWT_SECRET=change-me-to-a-long-random-secret
# 服务间内部调用令牌（网关注入、下游校验，必须一致）
AI_GROUP_INTERNAL_TOKEN=change-me-to-a-long-random-internal-token
# group trade 内部鉴权开关（默认 true；仅临时回滚/隔离排障时可设 false）
AI_GROUP_INTERNAL_AUTH_ENABLED=true

# ============ MySQL ============
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=123456

# ============ Redis ============
REDIS_HOST=127.0.0.1
REDIS_PORT=16379

# ============ RabbitMQ（Java 服务读取 RABBITMQ_USER/RABBITMQ_PASSWORD）============
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
# 是否启用权益/成团 MQ（本地可置 true）
AGENT_GROUP_RABBIT_ENABLED=true

# ============ Nacos ============
NACOS_HOST=127.0.0.1
NACOS_PORT=8848

# ============ 向量库 Qdrant ============
# QDRANT_URL 走 HTTP REST(6333)，QDRANT_PORT 是 gRPC 端口(6334)，与 Java 侧默认对齐
VECTOR_STORE_TYPE=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_PORT=6334
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false

# ============ 对象存储 MinIO ============
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ai-group
# 稳定下载代理（reactor-tool）；云端 MinerU 等可选 MINIO_PUBLIC_ENDPOINT
REACTOR_TOOL_PUBLIC_BASE_URL=http://127.0.0.1:1601/v1/storage
# MINIO_PUBLIC_ENDPOINT=https://minio.example.com

# ============ 大模型（阿里百炼 / DashScope，兼容 OpenAI 协议）============
AI_BAILIAN_API_KEY=sk-your-dashscope-key
DASHSCOPE_API_KEY=sk-your-dashscope-key
AGENT_GROUP_LLM_API_KEY=sk-your-dashscope-key
AGENT_GROUP_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_GROUP_LLM_CHAT_MODEL=qwen-plus
AGENT_GROUP_LLM_EMBEDDING_MODEL=text-embedding-v3
# Plan-Solve 质量门禁与定向重规划
AGENT_EVALUATOR_ENABLED=true
AGENT_EVALUATOR_LLM_JUDGE_ENABLED=true
AGENT_EVALUATOR_MODEL=qwen-plus
AGENT_EVALUATOR_SCORE_THRESHOLD=75
AGENT_EVALUATOR_MAX_REPLAN_ROUNDS=2
AGENT_EVALUATOR_REFLECTION_TOKEN_BUDGET=6000
AGENT_EVALUATOR_TIMEOUT_SECONDS=60
# Skills 渐进加载（仅先注入名称/用途，命中后加载 SKILL.md）
AGENT_SKILLS_ENABLED=true
AGENT_SKILLS_DIRECTORY=runtime/skills
# Python reactor-tool 读取 OPENAI_*（通常与上面同值）
OPENAI_API_KEY=sk-your-dashscope-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_MODEL=qwen-plus

# ============ 图片生成 ============
IMAGE_GENERATION_BASE_URL=https://your-image-gen-endpoint/v1
IMAGE_GENERATION_API_KEY=sk-your-image-gen-key
IMAGE_GENERATION_MODEL=your-image-model
GRSAI_NANOBANANA_API_KEY=your-nanobanana-key

# ============ 工具类 API ============
TAVILY_API_KEY=tvly-your-key
MINERU_API_KEY=your-mineru-token

# ============ reactor-tool（Python 工具服务，可选）============
AGENT_GROUP_REACTOR_TOOL_ENABLED=true
AGENT_GROUP_REACTOR_TOOL_BASE_URL=http://127.0.0.1:1601

# ============ 支付宝（沙箱）============
ALIPAY_ENABLED=false
ALIPAY_APP_ID=your-alipay-sandbox-appid
ALIPAY_MERCHANT_PRIVATE_KEY=your-merchant-private-key
ALIPAY_PUBLIC_KEY=your-alipay-public-key
ALIPAY_GATEWAY_URL=https://openapi.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=http://127.0.0.1:8070/api/v1/alipay/alipay_notify_url
ALIPAY_RETURN_URL=http://127.0.0.1:5173/pricing?tab=orders&paymentReturn=1

# ============ 前端 ============
# 前端 API 目标（Gateway 地址），vite.config 从仓库根 .env 读取 SERVICE_BASE_URL
SERVICE_BASE_URL=http://127.0.0.1:8080
VITE_API_TARGET=http://127.0.0.1:8080

# ============ 服务端口（参考）============
GATEWAY_PORT=8080
AUTH_PORT=8081
MEMBER_PORT=8082
BFF_PORT=8083
PAY_PORT=8070
GROUP_PORT=8091
AGENT_PORT=8090
