# 熊博士全栈环境变量模板（唯一权威）
# 复制后填真实密钥：
#   Copy-Item .env.example .env
#   docker compose --env-file .env -f dev-ops/compose/docker-compose.full.yml up --build
#
# 说明：
# - 带 PUBLISH 的端口给宿主机映射；Compose 内服务名会覆盖 MYSQL_HOST/REDIS_HOST/NACOS_HOST
# - full Compose 默认关闭 Nacos 鉴权、Redis 无密码；XXL-JOB 默认关闭（Pay 用本地 Outbox 调度）

# ---------- 必改：边界安全 ----------
AI_GROUP_INTERNAL_TOKEN=replace-with-a-long-random-service-token
AI_GROUP_IDENTITY_SIGNING_SECRET=replace-with-a-long-random-hmac-secret
SA_TOKEN_COOKIE_SECURE=false
AI_GROUP_INTERNAL_AUTH_ENABLED=true

# ---------- MySQL / Redis（本机直连 Java 时用 HOST/PORT；Compose 内会改成服务名） ----------
MYSQL_ROOT_PASSWORD=xiongdoctor_dev
MYSQL_USER=root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
REDIS_HOST=127.0.0.1
REDIS_PORT=16379

# ---------- Nacos（Compose 内 NACOS_HOST=nacos，且 AUTH 关闭） ----------
NACOS_HOST=127.0.0.1
NACOS_PORT=8848

# ---------- RabbitMQ ----------
RABBITMQ_DEFAULT_USER=xiongdoctor
RABBITMQ_DEFAULT_PASS=xiongdoctor_dev
RABBITMQ_EVENT_EXCHANGE=xiongdoctor.events

# ---------- Agent Postgres ----------
AGENT_POSTGRES_DB=xiongdoctor_agent
AGENT_POSTGRES_USER=xiongdoctor
AGENT_POSTGRES_PASSWORD=xiongdoctor_dev
AGENT_POSTGRES_PUBLISH_PORT=15432

# ---------- MinIO（Compose 会启动；当前业务主路径可不依赖） ----------
MINIO_ROOT_USER=xiongdoctor
MINIO_ROOT_PASSWORD=xiongdoctor_dev

# ---------- LangGraph / LLM（OpenAI 兼容；跑 Agent 时必填） ----------
# 也可用 AGENT_GROUP_LLM_* 作为兜底别名（仅当对应 OPENAI_* 未设置时生效）
LLM_ACTIVE_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-provider-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_MODEL_BALANCED=gpt-4o-mini

# Token 计费：按实际 Token 精确结算；输入每百万 Token 5 积分、输出每百万 Token 30 积分
# 1 积分 = 1,000,000 微积分
BILLING_INPUT_MICRO_POINTS_PER_TOKEN=5
BILLING_OUTPUT_MICRO_POINTS_PER_TOKEN=30
BILLING_DEFAULT_RESERVATION_MICRO_POINTS=500000

# ---------- Agent 搜索工具（可选；full Compose 会转发给 agent-service） ----------
TAVILY_API_KEY=
SERPER_API_KEY=
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1

# ---------- 支付宝沙箱（false 可用本地演示支付链路） ----------
ALIPAY_ENABLED=false
ALIPAY_STRICT=false
ALIPAY_APP_ID=your-alipay-sandbox-appid
ALIPAY_MERCHANT_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=http://localhost:8080/api/pay/alipay/notify
ALIPAY_RETURN_URL=http://localhost:5173/pricing?tab=orders&paymentReturn=1
AI_GROUP_PAY_SANDBOX_AMOUNT=0
AI_GROUP_DEMO_PAYMENT_ENABLED=false

# ---------- XXL-JOB（Admin + 执行器；默认开启，Pay Outbox 由 XXL 调度） ----------
XXL_JOB_ENABLED=true
XXL_JOB_ACCESS_TOKEN=default_token
XXL_JOB_ADMIN_ADDRESSES=http://127.0.0.1:18081/xxl-job-admin
XXL_JOB_ADMIN_PUBLISH_PORT=18081
XXL_JOB_MYSQL_USER=xxl_job
XXL_JOB_MYSQL_PASSWORD=xxl_job_dev
XXL_JOB_MYSQL_ROOT_PASSWORD=xxl_job_root_dev
# full Compose 内服务应使用 http://xxl-job-admin:8080/xxl-job-admin（compose 已默认注入）
# 开启 XXL 后保持 false，避免与 outboxEventPublishJob 双调度
PAY_OUTBOX_LOCAL_SCHEDULER_ENABLED=false

# ---------- 可选运行开关 ----------
AGENT_ENVIRONMENT=development

# ---------- 宿主机端口映射 ----------
GATEWAY_PUBLISH_PORT=8080
WEB_PUBLISH_PORT=5173
MYSQL_PUBLISH_PORT=13306
REDIS_PUBLISH_PORT=16379
RABBITMQ_PUBLISH_PORT=15672
RABBITMQ_AMQP_PUBLISH_PORT=5672
NACOS_PUBLISH_PORT=8848
NACOS_GRPC_PUBLISH_PORT=9848
MINIO_PUBLISH_PORT=9000
MINIO_CONSOLE_PUBLISH_PORT=9001
