# 熊博士全栈本地环境变量模板
# 复制为 .env 后填入真实密钥：
#   docker compose --env-file .env -f dev-ops/compose/docker-compose.full.yml up --build

# Java 边界安全
AI_GROUP_INTERNAL_TOKEN=replace-with-a-long-random-service-token
AI_GROUP_IDENTITY_SIGNING_SECRET=replace-with-a-long-random-hmac-secret
JWT_SECRET=legacy-only-not-used-by-sa-token
SA_TOKEN_COOKIE_SECURE=false

# MySQL / Redis
MYSQL_ROOT_PASSWORD=xiongdoctor_dev
MYSQL_USER=root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
REDIS_HOST=127.0.0.1
REDIS_PORT=16379

# 服务发现（Compose 内部会覆盖 host）
NACOS_HOST=127.0.0.1
NACOS_PORT=8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# Agent Postgres
AGENT_POSTGRES_DB=xiongdoctor_agent
AGENT_POSTGRES_USER=xiongdoctor
AGENT_POSTGRES_PASSWORD=xiongdoctor_dev
AGENT_POSTGRES_PUBLISH_PORT=15432

# LangGraph / LLM。使用 openai-compatible provider；只在真正运行 Agent 时必填。
LLM_ACTIVE_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-provider-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_MODEL_BALANCED=gpt-4o-mini

# Token 计费：按实际 Token 精确结算；当前费率为输入每百万 Token 5 积分、输出每百万 Token 30 积分。
# 配置仍使用微积分/Token 存储；1 积分 = 1,000,000 微积分。
BILLING_INPUT_MICRO_POINTS_PER_TOKEN=5
BILLING_OUTPUT_MICRO_POINTS_PER_TOKEN=30
BILLING_DEFAULT_RESERVATION_MICRO_POINTS=500000

# Agent 工具（可选）
TAVILY_API_KEY=
SERPER_API_KEY=
# 中文搜索/重排可选；未配置时会自动使用 Tavily 兜底。
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1
JINA_API_KEY=

# 支付宝沙箱；false 时可使用本地模拟回调/订单链路。
ALIPAY_ENABLED=false
ALIPAY_STRICT=false
ALIPAY_APP_ID=your-alipay-sandbox-appid
ALIPAY_MERCHANT_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=http://localhost:8080/api/pay/alipay/notify
ALIPAY_RETURN_URL=http://localhost:5173/orders?paymentReturn=1
AI_GROUP_PAY_SANDBOX_AMOUNT=0
AI_GROUP_DEMO_PAYMENT_ENABLED=false

# RabbitMQ（统一事件总线）
RABBITMQ_DEFAULT_USER=xiongdoctor
RABBITMQ_DEFAULT_PASS=xiongdoctor_dev

# 宿主机端口
GATEWAY_PUBLISH_PORT=8080
WEB_PUBLISH_PORT=5173
MYSQL_PUBLISH_PORT=13306
REDIS_PUBLISH_PORT=16379
RABBITMQ_PUBLISH_PORT=15672
RABBITMQ_AMQP_PUBLISH_PORT=5672
NACOS_PUBLISH_PORT=8848
NACOS_GRPC_PUBLISH_PORT=9848
MINIO_PUBLISH_PORT=9000
MINIO_CONSOLE_PUBLISH_PORT=9001
