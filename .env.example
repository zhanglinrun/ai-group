# AI Group 本地开发环境变量示例
# 用法：复制为 .env 并填入真实值。.env 已在 .gitignore 中，切勿提交真实密钥。
# `start-full-stack.ps1` 会把这些变量同时传给 Docker 基础设施、Java 服务、前端代理和 Python 工具。
# 手动在 docs/dev-ops 中运行 Compose 且需要自定义默认凭据时，请显式传入根环境文件：
# docker compose --env-file ../../.env -f docker-compose-platform.yml up -d

# ============ 安全（必填）============
# PowerShell 生成 32 字节随机值：
# $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Fill($bytes); [Convert]::ToBase64String($bytes)
# JWT 签名密钥（所有服务共享，必须一致）
JWT_SECRET=
# 服务间内部调用令牌（网关注入、下游校验，必须一致）
AI_GROUP_INTERNAL_TOKEN=
# XXL-JOB Admin 与所有执行器共享的访问令牌（必须与 Compose 启动参数一致）
XXL_JOB_ACCESS_TOKEN=researchpilot-xxl-job-local-2026
# Dockerized XXL Admin calls host-side executors through this address. Docker Desktop
# supports host.docker.internal; override only for a different container runtime.
XXL_JOB_EXECUTOR_ADVERTISE_HOST=host.docker.internal
# group trade 内部鉴权开关（默认 true；仅临时回滚/隔离排障时可设 false）
AI_GROUP_INTERNAL_AUTH_ENABLED=true

# ============ 冻结 Group/Pay 运行产物 ============
# full-stack 绝不在 group/ 或 s-pay-mall-ddd-market/ 内构建或启动 Maven。
# 指向仓库外的恢复目录；其中必须包含 group-buy-market-app.jar 与 s-pay-mall-ddd-app.jar。
# 留空时启动脚本会寻找仓库同级的 ai-group-generated-recovery/p130-generated-* 最新目录。
AI_GROUP_FROZEN_ARTIFACT_ROOT=
# Group/Pay 已恢复 JAR 的工作目录（日志、临时文件等）；必须在冻结源码目录之外。
# 留空时使用仓库同级 ai-group-runtime-data。
AI_GROUP_RUNTIME_DATA_ROOT=

# ============ MySQL ============
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
# 本地 Compose 默认由 root 连接；改成普通用户前需自行创建用户并授权各业务库
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=

# ============ Redis ============
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=

# ============ Kafka ============
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# Kafka 生产者确认超时（毫秒）
KAFKA_PUBLISH_CONFIRM_TIMEOUT_MS=5000

# 可选 observability compose；仅使用 -IncludeObservability 时必填
GRAFANA_ADMIN_PASSWORD=
PGVECTOR_PASSWORD=
REDIS_ADMIN_PASSWORD=

# ============ Nacos ============
NACOS_HOST=127.0.0.1
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
# Nacos 仅绑定 loopback，但仍启用鉴权；本地管理账号默认 nacos/nacos。
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# NACOS_AUTH_TOKEN 必须是 Base64 编码且原始密钥不少于 32 字节。
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

# ============ PostgreSQL / pgvector ============
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=agent_memory
POSTGRES_USER=agent
POSTGRES_PASSWORD=researchpilot-postgres-local-2026
AGENT_MEMORY_LONGTERM_ENABLED=true
AGENT_GROUP_VECTOR_DIMENSION=1024

# ============ MinIO（私有对象存储）============
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=agent
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=ai-group-files
# 可选：生产环境使用专用访问凭据；必须成对配置。留空时本地回退到 ROOT 凭据。
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ============ 大模型（阿里百炼 / DashScope，兼容 OpenAI 协议）============
AI_BAILIAN_API_KEY=sk-your-dashscope-key
DASHSCOPE_API_KEY=sk-your-dashscope-key
AGENT_GROUP_LLM_API_KEY=sk-your-dashscope-key
AGENT_GROUP_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_GROUP_LLM_CHAT_MODEL=qwen-plus
AGENT_GROUP_VISION_MODEL=qwen-vl-plus
AGENT_GROUP_MEMORY_SUMMARY_MODEL=qwen-plus
# Chat 与 embedding 可使用不同的 OpenAI-compatible provider；留空时优先回退 DASHSCOPE_*。
AGENT_GROUP_EMBEDDING_API_KEY=
AGENT_GROUP_EMBEDDING_BASE_URL=
AGENT_GROUP_LLM_EMBEDDING_MODEL=text-embedding-v3
# Skills 渐进加载（仅先注入名称/用途，命中后加载 SKILL.md）
AGENT_SKILLS_ENABLED=true
AGENT_SKILLS_DIRECTORY=runtime/skills
# Python runtime/tools 读取 OPENAI_*（通常与上面同值）
OPENAI_API_KEY=sk-your-dashscope-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_MODEL=qwen-plus
REPORT_MODEL=qwen-plus

# ============ 图片生成 ============
IMAGE_GENERATION_BASE_URL=https://your-image-gen-endpoint/v1
IMAGE_GENERATION_API_KEY=sk-your-image-gen-key
IMAGE_GENERATION_MODEL=your-image-model
GRSAI_NANOBANANA_API_KEY=your-nanobanana-key

# ============ 工具类 API ============
TAVILY_API_KEY=tvly-your-key
MINERU_API_KEY=your-mineru-token

# ============ runtime/tools（Python 工具服务，可选）============
AGENT_GROUP_REACTOR_TOOL_ENABLED=true
AGENT_GROUP_REACTOR_TOOL_BASE_URL=http://127.0.0.1:1601
# 工具服务使用独立令牌，不复用平台内部令牌。
AGENT_GROUP_REACTOR_TOOL_TOKEN=
REACTOR_TOOL_ENV=local
REACTOR_TOOL_HOST=127.0.0.1
REACTOR_TOOL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SKILL_ALLOWED_RUNTIMES=python
FILE_MAX_SIZE_MB=100

# ============ 支付宝（沙箱）============
ALIPAY_ENABLED=false
ALIPAY_APP_ID=your-alipay-sandbox-appid
ALIPAY_MERCHANT_PRIVATE_KEY=your-merchant-private-key
ALIPAY_PUBLIC_KEY=your-alipay-public-key
ALIPAY_GATEWAY_URL=https://openapi.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=http://127.0.0.1:8070/api/v1/alipay/alipay_notify_url
ALIPAY_RETURN_URL=http://127.0.0.1:5173/pricing?tab=orders&paymentReturn=1
# 0 表示按套餐价；仅演示真实支付通道时才改为 0.01 等小额
AI_GROUP_PAY_SANDBOX_AMOUNT=0
# 本地开发演示开关：仅 dev profile 生效；开启后 UI 会明确展示“本地演示支付”按钮。
AI_GROUP_DEMO_PAYMENT_ENABLED=false

# ============ 前端 ============
# 前端 API 目标（Gateway 地址），vite.config 从仓库根 .env 读取 SERVICE_BASE_URL
SERVICE_BASE_URL=http://127.0.0.1:8080
VITE_API_TARGET=http://127.0.0.1:8080

# ============ 固定服务端口（仅供查阅；一键脚本与路由按此拓扑启动）============
GATEWAY_PORT=8080
AUTH_PORT=8081
MEMBER_PORT=18082
BFF_PORT=8083
PAY_PORT=8070
GROUP_PORT=8091
AGENT_PORT=8090
